# Traefik-specific overrides.
# Copy to .env and fill in values (inherits DOMAIN and ACME_EMAIL from root .env).

# Basic-auth credentials for the Traefik dashboard
# Generate with: echo $(htpasswd -nb admin your_password) | sed -e 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$placeholder$$hash
