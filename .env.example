# ─────────────────────────────────────────────────────────────────────────────
# Global environment variables shared across all services.
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# Domain used for Traefik routing (e.g. example.com)
DOMAIN=example.com

# E-mail address used for Let's Encrypt certificate registration
ACME_EMAIL=admin@example.com

# Timezone for all containers (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Berlin
